# ── Medusa Backend URL ────────────────────────────────────────────────────────
# Khi deploy lên Vercel: thay bằng URL thật của backend (Railway, Render, VPS...)
# Ví dụ: https://api.sprylo.up.railway.app
VITE_MEDUSA_BACKEND_URL=https://your-backend-url.com

# ── Medusa Publishable API Key ────────────────────────────────────────────────
# Lấy tại: Medusa Admin → Settings → API Keys → Publishable Keys
VITE_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
