{
  "name": "medusa-backend",
  "private": false,
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "cd apps/backend && npm run dev",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "seed-phones": "medusa exec ./apps/backend/src/scripts/seed-phones.ts"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "@medusajs/types": "^2.17.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {},
  "dependencies": {
    "date-fns": "^3.6.0"
  }
}
